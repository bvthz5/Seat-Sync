# ==========================================
# FRONTEND SERVER CONFIGURATION
# ==========================================
# Port number for the frontend local development server to run on.
VITE_PORT=specify_frontend_port_number_here

# Network host binding configuration for the development server (true or host string).
VITE_HOST=specify_true_or_host_interface_here

# Comma-separated list of domain hostnames allowed to access the frontend development server.
VITE_ALLOWED_HOSTS=specify_allowed_hostnames_separated_by_commas_here

# ==========================================
# INSTITUTIONAL DOMAIN
# ==========================================
# Official college domain name for email address validations.
VITE_COLLEGE_EMAIL_DOMAIN=specify_college_email_domain_here

# ==========================================
# BACKEND API & WEBSOCKET CONNECTION
# ==========================================
# Full public URL of the backend API server.
VITE_API_URL=specify_backend_api_base_url_here

# Relative base path for API requests (e.g. /api).
VITE_API_BASE_URL=specify_api_route_prefix_here

# Full URL of the backend WebSocket server for real-time notifications.
VITE_SOCKET_URL=specify_backend_websocket_url_here
