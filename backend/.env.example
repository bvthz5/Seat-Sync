# ==========================================
# SERVER & NETWORK CONFIGURATION
# ==========================================
# Port number on which the backend Express server will listen.
PORT=specify_your_backend_port_number_here

# Network interface host address to bind the server.
HOST=specify_your_host_address_here

# Runtime environment mode for the application (development, production, or test).
NODE_ENV=specify_your_environment_mode_here

# Full public domain URL for accessing the backend server.
BACKEND_URL=specify_your_backend_public_url_here

# Full public domain URL for accessing the frontend client application.
FRONTEND_URL=specify_your_frontend_public_url_here

# ==========================================
# CORS & REVERSE PROXY SECURITY
# ==========================================
# Comma-separated list of allowed origins or domain wildcard patterns for Cross-Origin Resource Sharing.
ALLOWED_ORIGINS=specify_allowed_origins_separated_by_commas_here

# Set to true to allow local development origins, or false to restrict strictly to production domains.
ALLOW_LOCALHOST=specify_true_or_false_here

# Number of reverse proxy hops to trust when running behind Nginx, Cloudflare, or a load balancer.
TRUST_PROXY=specify_trusted_proxy_hops_count_here

# Maximum number of API requests permitted per client IP within the rate-limiting window.
RATE_LIMIT_MAX=specify_maximum_rate_limit_requests_here

# Base root domain used for sharing authentication cookies across subdomains.
COOKIE_DOMAIN=specify_cookie_domain_for_subdomains_here

# SameSite cookie policy to protect against cross-site request forgery (lax, strict, or none).
COOKIE_SAME_SITE=specify_cookie_same_site_policy_here

# Set to true to ensure cookies are only transmitted over HTTPS connections, or false for local HTTP.
COOKIE_SECURE=specify_true_for_https_or_false_for_http_here

# ==========================================
# INSTITUTIONAL DOMAIN & DEFAULT CREDENTIALS
# ==========================================
# Official institutional email domain suffix required for user registrations and logins.
COLLEGE_EMAIL_DOMAIN=specify_your_college_email_domain_here

# Default initial password assigned to newly created or bulk-imported student accounts.
STUDENT_DEFAULT_PASSWORD=specify_default_temporary_student_password_here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# SQL dialect used by the database ORM (mysql, postgres, sqlite, or mariadb).
DB_DIALECT=specify_database_dialect_here

# Hostname or IP address of the database server.
DB_HOST=specify_database_host_here

# Port number on which the database server is listening.
DB_PORT=specify_database_port_here

# Name of the application database schema to connect to.
DB_NAME=specify_database_name_here

# Database username with read and write permissions for the application.
DB_USER=specify_database_username_here

# Password corresponding to the database user account.
DB_PASS=specify_database_password_here

# Set to true to allow automatic fallback to SQLite if the primary database is unreachable.
DB_FALLBACK_TO_SQLITE=specify_true_or_false_here

# ==========================================
# JWT AUTHENTICATION SECRETS & EXPIRY
# ==========================================
# Cryptographically secure random secret key used to sign and verify short-lived access tokens.
JWT_ACCESS_SECRET=specify_cryptographically_secure_random_access_token_secret_here

# Cryptographically secure random secret key used to sign and verify long-lived refresh tokens.
JWT_REFRESH_SECRET=specify_cryptographically_secure_random_refresh_token_secret_here

# Expiration duration string for access tokens.
JWT_ACCESS_EXPIRY=specify_access_token_expiry_duration_here

# Expiration duration string for refresh tokens.
JWT_REFRESH_EXPIRY=specify_refresh_token_expiry_duration_here

# ==========================================
# INITIAL ROOT ADMIN CREDENTIALS
# ==========================================
# Email address for the initial root administrator created during database initialization.
ADMIN_EMAIL=specify_root_administrator_email_address_here

# Secure password for the initial root administrator account.
ADMIN_PASSWORD=specify_strong_root_administrator_password_here

# ==========================================
# TEST USERS (OPTIONAL FOR AUTOMATED TESTS)
# ==========================================
# Optional email for test student account during integration tests.
TEST_STUDENT_EMAIL=specify_test_student_email_if_needed

# Optional password for test student account.
TEST_STUDENT_PASSWORD=specify_test_student_password_if_needed

# Optional email for test invigilator account during integration tests.
TEST_INVIGILATOR_EMAIL=specify_test_invigilator_email_if_needed

# Optional password for test invigilator account.
TEST_INVIGILATOR_PASSWORD=specify_test_invigilator_password_if_needed

# ==========================================
# SMTP EMAIL NOTIFICATION CONFIGURATION
# ==========================================
# Host address of the outgoing SMTP mail transfer agent server.
SMTP_HOST=specify_smtp_server_host_here

# Port number used to connect to the SMTP mail server.
SMTP_PORT=specify_smtp_server_port_here

# Set to true for direct SSL/TLS connections, or false when using opportunistic STARTTLS.
SMTP_SECURE=specify_true_for_ssl_or_false_for_starttls_here

# Username or email address used to authenticate with the SMTP server.
SMTP_USER=specify_smtp_username_or_email_here

# Password or app-specific authentication token for the SMTP service account.
SMTP_PASS=specify_smtp_password_or_token_here

# Sender email address that will appear in the From header of outgoing notification emails.
FROM_EMAIL=specify_outgoing_sender_email_address_here
